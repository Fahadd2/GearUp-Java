# GearUp backend configuration (Twelve-Factor, Factor III: config lives in the environment).
#
# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.
# Java does not read .env files by itself; see "Configure" in README.md for how to load it.

# HTTP port to listen on. Optional, defaults to 8080.
PORT=8080

# PostgreSQL connection (JDBC URL). Required.
#   Local Docker database:  jdbc:postgresql://localhost:5432/gearup
#   Supabase / cloud:       jdbc:postgresql://<host>:5432/postgres?sslmode=require
GEARUP_DB_URL=jdbc:postgresql://localhost:5432/gearup
GEARUP_DB_USER=postgres
GEARUP_DB_PASSWORD=change-me

# Key used to sign login tokens (HS256). Required, at least 32 characters.
# Generate one with:  openssl rand -base64 48
# Every copy of the app in one environment must use the same value.
GEARUP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
